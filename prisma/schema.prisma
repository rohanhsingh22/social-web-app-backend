generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  muted
  banned
  deleted
}

enum UserRole {
  user
  moderator
  admin
  owner
}

enum ChannelType {
  language
  age
  region
  general
  toli
}

enum ChannelVisibility {
  public
  private
}

enum MessageStatus {
  active
  deleted
  hidden
  flagged
}

enum ConnectionStatus {
  pending
  accepted
  rejected
  cancelled
  blocked
}

enum ReportStatus {
  open
  reviewing
  resolved
  rejected
}

enum ReportReason {
  spam
  harassment
  hate_or_abuse
  sexual_content
  fake_profile
  underage_safety
  other
}

enum BannedWordSeverity {
  low
  medium
  high
}

enum ProfilePictureType {
  provider
  toli
}

enum NotificationType {
  connection_request
  connection_accepted
  new_dm
  legal_notice
}

enum HomeMemberRole {
  OWNER
  PARTICIPANT
}

enum HomeInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum HomeJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  publicUserId      String             @unique @map("public_user_id")
  status            UserStatus         @default(active)
  role              UserRole           @default(user)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(6)
  identities        AuthIdentity[]
  sessions          Session[]
  profile           Profile?
  settings          UserSettings?
  channelMessages   ChannelMessage[]   @relation("ChannelMessageSender")
  deletedMessages   ChannelMessage[]   @relation("ChannelMessageDeletedBy")
  connectionsSent   Connection[]       @relation("ConnectionRequester")
  connectionsGot    Connection[]       @relation("ConnectionReceiver")
  conversationLinks ConversationMember[]
  directMessages    DirectMessage[]
  reportsMade       Report[]           @relation("ReportReporter")
  reportsAgainst    Report[]           @relation("ReportTargetUser")
  reviewedReports   Report[]           @relation("ReportReviewer")
  blocksMade        Block[]            @relation("BlockBlocker")
  blocksReceived    Block[]            @relation("BlockBlocked")
  thoughts          Thought[]
  thoughtLikes      ThoughtLike[]
  thoughtComments   ThoughtComment[]
  thoughtShares     ThoughtShare[]
  thoughtHides      ThoughtHide[]
  thoughtReports    ThoughtReport[]
  thoughtEvents     ThoughtEvent[]
  notifications     Notification[]
  adminSessions     AdminSession[]
  mfaCredential     AdminMfaCredential?
  recoveryCodes     AdminRecoveryCode[]
  invitationsReceived AdminInvitation[] @relation("AdminInvitationInvitee")
  invitationsSent   AdminInvitation[] @relation("AdminInvitationInviter")
  ownedHome               Home?             @relation("HomeOwner")
  homeMembership          HomeMembership?
  homeInvitationsSent     HomeInvitation[]  @relation("HomeInvitationInviter")
  homeInvitationsReceived HomeInvitation[]  @relation("HomeInvitationInvitee")
  homeJoinRequestsSent    HomeJoinRequest[] @relation("HomeJoinRequestRequester")
  homeJoinRequestsTargeted HomeJoinRequest[] @relation("HomeJoinRequestTarget")
  charactersOwned       UserCharacter[]
  characterItemsOwned UserCharacterItem[]
  eventCoinWallet     EventCoinWallet?
  eventCoinTransactions EventCoinTransaction[]

  // Phase 2 admin directory: status/role-filtered, recency-ordered reads.
  @@index([status, createdAt(sort: Desc)])
  @@index([role, createdAt(sort: Desc)])
  @@map("users")
}

model AuthIdentity {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  provider            String
  providerUserId      String   @map("provider_user_id")
  providerEmail       String?  @map("provider_email")
  providerDisplayName String?  @map("provider_display_name")
  providerAvatarUrl   String?  @map("provider_avatar_url")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Profile {
  userId          String   @id @map("user_id") @db.Uuid
  username        String   @unique
  displayName     String   @map("display_name")
  // Lowercase(trim(displayName)). Uniqueness authority for Launch 1 identity:
  // Rohan/rohan/ROHAN collide. Always written alongside displayName.
  displayNameNormalized String @unique @map("display_name_normalized")
  avatarUrl       String?  @map("avatar_url")
  // Active profile-picture source. Provider avatar lives on AuthIdentity and
  // is synced at login; a Toli avatar is a fixed catalog key (toliAvatarKey)
  // validated against the user's current Toli. Never overwritten implicitly.
  profilePictureType ProfilePictureType @default(provider) @map("profile_picture_type")
  toliAvatarKey      String?            @map("toli_avatar_key")
  bio             String?
  dob             DateTime? @db.Date
  ageGroup        String?  @map("age_group")
  gender          String?
  characterConfig Json?    @map("character_config")
  region          String?
  city            String?
  primaryLanguage String?  @map("primary_language")
  languages       String[]
  interests       String[] @default([])
  // Optional clan identity. Null = no Toli (fully supported, no Toli room).
  toliId          String?  @map("toli_id") @db.Uuid
  toli            Toli?    @relation(fields: [toliId], references: [id], onDelete: SetNull)
  isComplete      Boolean  @default(false) @map("is_complete")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([region])
  @@index([ageGroup])
  @@index([toliId])
  @@map("profiles")
}

model Channel {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  slug      String           @unique
  type      ChannelType
  visibility ChannelVisibility @default(public)
  isDefault Boolean          @default(false) @map("is_default")
  isActive  Boolean          @default(true) @map("is_active")
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages  ChannelMessage[]
  // Set only for Toli rooms: exactly one channel per Toli. Null = public room.
  toliId    String?          @unique @map("toli_id") @db.Uuid
  toli      Toli?            @relation(fields: [toliId], references: [id], onDelete: SetNull)

  @@map("channels")
}

model Toli {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String
  motto       String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  profiles    Profile[]
  channels    Channel[]

  @@map("tolis")
}

model ChannelMessage {
  id        String        @id @default(uuid()) @db.Uuid
  channelId String        @map("channel_id") @db.Uuid
  senderId  String        @map("sender_id") @db.Uuid
  body      String
  status    MessageStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?       @map("deleted_by") @db.Uuid
  channel   Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User          @relation("ChannelMessageSender", fields: [senderId], references: [id])
  deleter   User?         @relation("ChannelMessageDeletedBy", fields: [deletedBy], references: [id])
  reports   Report[]

  @@index([channelId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([createdAt])
  @@map("channel_messages")
}

model Connection {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  receiverId  String           @map("receiver_id") @db.Uuid
  userLowId   String           @map("user_low_id") @db.Uuid
  userHighId  String           @map("user_high_id") @db.Uuid
  status      ConnectionStatus
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
  @@index([receiverId, status, createdAt(sort: Desc)])
  @@index([requesterId, status, createdAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@map("connections")
}

model Conversation {
  id        String               @id @default(uuid()) @db.Uuid
  type      String               @default("direct")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  members   ConversationMember[]
  messages  DirectMessage[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model DirectMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  senderId       String        @map("sender_id") @db.Uuid
  body           String
  status         MessageStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id])
  reports        Report[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("direct_messages")
}

model Thought {
  id        String        @id @default(uuid()) @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  body      String
  status    MessageStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     ThoughtLike[]
  comments  ThoughtComment[]
  shares    ThoughtShare[]
  hides     ThoughtHide[]
  reports   ThoughtReport[]
  events    ThoughtEvent[]

  @@index([authorId])
  @@index([status, createdAt(sort: Desc)])
  @@map("thoughts")
}

model ThoughtLike {
  thoughtId String   @map("thought_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  thought   Thought  @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([thoughtId, userId])
  @@index([userId, thoughtId])
  @@map("thought_likes")
}

model ThoughtComment {
  id        String        @id @default(uuid()) @db.Uuid
  thoughtId String        @map("thought_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  body      String
  status    MessageStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  thought   Thought       @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([thoughtId, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("thought_comments")
}

model ThoughtShare {
  thoughtId String   @map("thought_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  thought   Thought  @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([thoughtId, userId])
  @@index([userId, thoughtId])
  @@map("thought_shares")
}

model ThoughtHide {
  thoughtId String   @map("thought_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  thought   Thought  @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([thoughtId, userId])
  @@index([userId, thoughtId])
  @@map("thought_hides")
}

model ThoughtReport {
  id         String       @id @default(uuid()) @db.Uuid
  thoughtId  String       @map("thought_id") @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  reason     ReportReason
  details    String?
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedBy String?      @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  thought    Thought      @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([thoughtId])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId])
  @@map("thought_reports")
}

model ThoughtEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  // Null for non-thought events (profile_open, connection_request).
  thoughtId String?  @map("thought_id") @db.Uuid
  type      String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  thought   Thought? @relation(fields: [thoughtId], references: [id], onDelete: Cascade)

  @@index([thoughtId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("thought_events")
}

model Report {
  id                     String          @id @default(uuid()) @db.Uuid
  reporterId             String          @map("reporter_id") @db.Uuid
  targetUserId           String?         @map("target_user_id") @db.Uuid
  targetChannelMessageId String?         @map("target_channel_message_id") @db.Uuid
  targetDirectMessageId  String?         @map("target_direct_message_id") @db.Uuid
  reason                 ReportReason
  details                String?
  status                 ReportStatus    @default(open)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedBy             String?         @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  reporter               User            @relation("ReportReporter", fields: [reporterId], references: [id])
  targetUser             User?           @relation("ReportTargetUser", fields: [targetUserId], references: [id])
  channelMessage         ChannelMessage? @relation(fields: [targetChannelMessageId], references: [id])
  directMessage          DirectMessage?  @relation(fields: [targetDirectMessageId], references: [id])
  reviewer               User?           @relation("ReportReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId])
  @@map("reports")
}

model Block {
  id            String   @id @default(uuid()) @db.Uuid
  blockerId     String   @map("blocker_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker       User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("BlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
  @@map("blocks")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  type        NotificationType
  title       String
  body        String?
  metadata    Json?
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz(6)
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("notifications")
}

model ModerationAction {
  id              String   @id @default(uuid()) @db.Uuid
  adminId         String   @map("admin_id") @db.Uuid
  targetUserId    String?  @map("target_user_id") @db.Uuid
  targetMessageId String?  @map("target_message_id") @db.Uuid
  action          String
  reason          String?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([adminId])
  @@index([targetUserId])
  @@map("moderation_actions")
}

// Phase 1 admin console: isolated privileged sessions, MFA, staff invites
// and append-only audit. Social sessions (Session) are never valid on admin routes.
model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @map("token_hash")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Absolute expiry. Idle expiry is derived from lastSeenAt in application code.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  // Set when MFA was verified for this session. Null = never fully authenticated.
  mfaAt         DateTime? @map("mfa_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminMfaCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  type            String    @default("totp")
  // AES-256-GCM envelope: base64(nonce):base64(ciphertext+tag).
  secretEncrypted String    @map("secret_encrypted")
  enabledAt       DateTime  @default(now()) @map("enabled_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  // RFC 6238 time-step of last accepted code. Rejects same/older steps (replay).
  lastUsedStep    BigInt?   @map("last_used_step")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_mfa_credentials")
}

model AdminRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_recovery_codes")
}

model AdminInvitation {
  id         String    @id @default(uuid()) @db.Uuid
  // Invitee must be an existing user; role is granted on accept, never before.
  userId     String    @map("user_id") @db.Uuid
  role       UserRole
  // SHA-256 hex of the single-use token. The raw token is shown once.
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation("AdminInvitationInvitee", fields: [userId], references: [id], onDelete: Cascade)
  inviter    User      @relation("AdminInvitationInviter", fields: [invitedBy], references: [id])

  @@index([userId])
  @@map("admin_invitations")
}

// Append-only application trail for consequential admin actions.
// ModerationAction (legacy) is still written for compatibility.
model AdminAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  // Role at read time is resolved via actor join; stored when known at write time.
  actorRole      String?  @map("actor_role")
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  reason         String?
  // Redacted before/after fragments only. Never tokens, secrets or raw bodies.
  metadata       Json?
  requestId      String?  @map("request_id")
  idempotencyKey String?  @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("admin_audit_events")
}

model BannedWord {
  id        String             @id @default(uuid()) @db.Uuid
  word      String             @unique
  severity  BannedWordSeverity @default(medium)
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("banned_words")
}

model UserSettings {
  userId            String   @id @map("user_id") @db.Uuid
  theme             String   @default("system") @map("theme")
  accentColor       String   @default("blue") @map("accent_color")
  profileVisibility Json     @default("{}") @map("profile_visibility")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Hirotoli Home Social Voice (Phase 1 domain foundation).
// PostgreSQL is authoritative for membership. Presence (Redis) and
// voice (SFU) are separate concerns and are never stored here.
model Home {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @unique @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User            @relation("HomeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships HomeMembership[]
  invitations HomeInvitation[]
  joinRequests HomeJoinRequest[]

  @@map("homes")
}

model HomeMembership {
  id       String         @id @default(uuid()) @db.Uuid
  homeId   String         @map("home_id") @db.Uuid
  userId   String         @unique @map("user_id") @db.Uuid
  role     HomeMemberRole @default(PARTICIPANT)
  joinedAt DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  home     Home           @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeId, userId])
  @@map("home_memberships")
}

model HomeInvitation {
  id          String               @id @default(uuid()) @db.Uuid
  homeId      String               @map("home_id") @db.Uuid
  inviterId   String               @map("inviter_id") @db.Uuid
  inviteeId   String               @map("invitee_id") @db.Uuid
  status      HomeInvitationStatus @default(PENDING)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz(6)
  respondedAt DateTime?            @map("responded_at") @db.Timestamptz(6)
  home        Home                 @relation(fields: [homeId], references: [id], onDelete: Cascade)
  inviter     User                 @relation("HomeInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User                 @relation("HomeInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([homeId, status])
  @@index([expiresAt])
  @@map("home_invitations")
}

model HomeJoinRequest {
  id             String                @id @default(uuid()) @db.Uuid
  homeId         String                @map("home_id") @db.Uuid
  requesterId    String                @map("requester_id") @db.Uuid
  targetMemberId String                @map("target_member_id") @db.Uuid
  status         HomeJoinRequestStatus @default(PENDING)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime              @map("expires_at") @db.Timestamptz(6)
  respondedAt    DateTime?             @map("responded_at") @db.Timestamptz(6)
  home           Home                  @relation(fields: [homeId], references: [id], onDelete: Cascade)
  requester      User                  @relation("HomeJoinRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetMember   User                  @relation("HomeJoinRequestTarget", fields: [targetMemberId], references: [id], onDelete: Cascade)

  @@index([targetMemberId, status])
  @@index([homeId, status])
  @@index([expiresAt])
  @@map("home_join_requests")
}

// HiRotoli character system (character-and-theme spec §6-7, §19-20).
// Catalog rows are reference data (seeded, never user-created at launch).
// Ownership/inventory are per-user grants validated server-side.
model Character {
  id               String   @id
  name             String
  assetId          String   @map("asset_id")
  rigId            String   @map("rig_id")
  defaultLoadoutId String   @map("default_loadout_id")
  unlockType       String   @map("unlock_type")
  unlockAmount     Int?     @map("unlock_amount")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owners           UserCharacter[]

  @@map("characters")
}

model CharacterItem {
  id                     String   @id
  category               String
  assetId                String   @map("asset_id")
  rigId                  String   @map("rig_id")
  attachment             Json
  compatibleCharacterIds String[] @map("compatible_character_ids")
  sourceType             String   @map("source_type")
  eventId                String?  @map("event_id")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owners                 UserCharacterItem[]

  @@index([category])
  @@index([sourceType])
  @@map("character_items")
}

model UserCharacter {
  userId      String    @map("user_id") @db.Uuid
  characterId String    @map("character_id")
  acquiredAt  DateTime  @default(now()) @map("acquired_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([userId, characterId])
  @@index([characterId])
  @@map("user_characters")
}

model UserCharacterItem {
  userId     String        @map("user_id") @db.Uuid
  itemId     String        @map("item_id")
  eventId    String?       @map("event_id")
  acquiredAt DateTime      @default(now()) @map("acquired_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       CharacterItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([itemId])
  @@map("user_character_items")
}

// Event Coins economy (spec §19). Renderer never sees balances — the
// character service consumes already-authorized ownership only.
model EventCoinWallet {
  userId    String   @id @map("user_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("event_coin_wallets")
}

model EventCoinTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("event_coin_transactions")
}

// Event world layers (spec §15-16). Empty at launch; future events insert
// rows with a time window. Resolver overlays active rows onto the default.
model HomeWorldThemeLayer {
  id          String    @id @default(uuid()) @db.Uuid
  priority    Int       @default(0)
  environment Json?
  lighting    Json?
  atmosphere  Json?
  decorations Json?
  audio       Json?
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, startsAt, endsAt])
  @@index([priority])
  @@map("home_world_theme_layers")
}
