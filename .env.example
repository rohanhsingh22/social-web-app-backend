NODE_ENV=development
PORT=3000
REALTIME_PORT=3001
WORKER_PORT=3002
API_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_chat?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_ISSUER=hirotoli-api
JWT_AUDIENCE=hirotoli-client
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:5174
# Admin console (Phase 1). ADMIN_APP_BASE_URL must be allowlisted above and in Google OAuth.
ADMIN_APP_BASE_URL=http://localhost:5174
ADMIN_GOOGLE_CALLBACK_URL=http://localhost:3000/admin/auth/callback/google
ADMIN_ACCESS_TOKEN_TTL=10m
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=12
ADMIN_MFA_PENDING_MINUTES=10
ADMIN_INVITE_TTL_HOURS=48
# 64 hex chars (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Required in production; development uses an ephemeral key with a boot warning.
ADMIN_MFA_ENCRYPTION_KEY=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
# Home voice (LiveKit SFU, Phase 7). Empty = voice tokens fail closed.
LIVEKIT_URL=wss://hirotoli-zm91w4j9.livekit.cloud
LIVEKIT_API_KEY=APIucGKjwCSY2r9
LIVEKIT_API_SECRET=dYjpX7YEfzDyb2dgf7vnKqWeTabfJUcLIA3vWniiNkeH
# Hirotoli Home rollout lever (spec #136). Unset = enabled. Set false to
# disable every /home route with HOME_DISABLED without reverting code.
HOME_SOCIAL_VOICE_ENABLED=true
LOG_LEVEL=log
# Days to keep channel/DM messages. 0 (default) keeps everything forever.
MESSAGE_RETENTION_DAYS=0
