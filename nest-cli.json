{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.build.json"
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "src/apps/api",
      "entryFile": "main",
      "sourceRoot": "src/apps/api"
    },
    "realtime": {
      "type": "application",
      "root": "src/apps/realtime",
      "entryFile": "main",
      "sourceRoot": "src/apps/realtime"
    },
    "worker": {
      "type": "application",
      "root": "src/apps/worker",
      "entryFile": "main",
      "sourceRoot": "src/apps/worker"
    }
  }
}
